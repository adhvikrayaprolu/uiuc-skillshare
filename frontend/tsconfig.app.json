{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true
  },
  "include": [
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/app/App.tsx",
    "src/app/routes.tsx",
    "src/components/**/*.tsx",
    "src/layouts/**/*.tsx",
    "src/pages/**/*.tsx",
    "src/lib/**/*.ts",
    "src/data/**/*.ts"
  ]
}
