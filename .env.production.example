# Configuration template for a future approved host; NOT consumed by local Compose.
# Replace placeholders privately. Do not provision or deploy as part of this milestone.
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=REPLACE_WITH_PRIVATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
APP_PUBLIC_URL=https://skillshare.example.invalid
ALLOWED_HOSTS=skillshare.example.invalid
# Persistent Django: direct connection, or session pooler on port 5432.
# URL-encode the password; use the restricted application role.
DATABASE_URL=postgresql://skillshare_app:REPLACE_PASSWORD@REPLACE_DB_HOST:5432/postgres
DB_SCHEMA=skillshare
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/supabase-ca.crt
DB_CONN_MAX_AGE=30
# Empty for app/worker; migration process uses its dedicated role/connection.
DB_MIGRATION_ROLE=
REDIS_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@REPLACE_REDIS_HOST:6379/0
EMAIL_HOST=REPLACE_SMTP_HOST
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REPLACE_SMTP_USER
EMAIL_HOST_PASSWORD=REPLACE_SMTP_PASSWORD
DEFAULT_FROM_EMAIL=SkillShare <REPLACE_VERIFIED_SENDER>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Build the frontend with the same GOOGLE_CLIENT_ID as the backend.
# Trust proxy headers only when an approved proxy strips client-supplied values.
TRUST_PROXY_HEADERS=false
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
AVATAR_STORAGE=supabase
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_STORAGE_KEY=REPLACE_SERVER_ONLY_SECRET_KEY
AI_PAID_CALLS_ENABLED=false
AI_DAILY_CALL_LIMIT=0
OPENAI_API_KEY=
