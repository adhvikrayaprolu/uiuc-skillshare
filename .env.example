# Safe local defaults only. Configure private values separately for eventual hosting.
ENVIRONMENT=local
SECRET_KEY=dev-only-local-secret-key-change-before-production-12345
APP_PORT=8080
MAIL_PORT=8025
POSTGRES_PASSWORD=local-skillshare-only
GOOGLE_CLIENT_ID=
